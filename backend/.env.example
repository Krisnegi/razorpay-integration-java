# Server Config
PORT=5005
NODE_ENV=development

# Database Configuration (Used by Prisma & Docker)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/razorpay_db?schema=public"

# Razorpay credentials (Get these from Razorpay Dashboard -> Settings -> API Keys)
# Use your Test Mode credentials for development
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourKeySecret

# Razorpay Webhook Secret (Set this when configuring Webhook in Razorpay dashboard)
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecret

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Meta WhatsApp Cloud API (Expose your Meta Business Credentials)
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
